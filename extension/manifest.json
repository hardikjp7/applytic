{
  "manifest_version": 3,
  "name": "Applytic - Add to Tracker",
  "version": "1.0.0",
  "description": "One-click add job postings from LinkedIn, Indeed, and Glassdoor straight into your Applytic tracker.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["identity", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://mbjyu0w1k5.execute-api.us-east-1.amazonaws.com/*",
    "https://applytic-auth.auth.us-east-1.amazoncognito.com/*"
  ],
  "content_scripts": [],
  "externally_connectable": {
    "matches": []
  }
}
