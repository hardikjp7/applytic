{
  "manifest_version": 3,
  "name": "Applytic - Add to Tracker",
  "version": "1.0.1",
  "description": "One-click add job postings from LinkedIn, Indeed, and Glassdoor straight into your Applytic tracker.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["identity", "storage", "activeTab"],
  "host_permissions": [
    "https://mbjyu0w1k5.execute-api.us-east-1.amazonaws.com/*",
    "https://applytic-auth.auth.us-east-1.amazoncognito.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content-scripts/shared.js", "content-scripts/linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.indeed.com/viewjob*", "https://*.indeed.com/jobs*"],
      "js": ["content-scripts/shared.js", "content-scripts/indeed.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.glassdoor.com/job-listing/*",
        "https://www.glassdoor.com/Job/*",
        "https://www.glassdoor.co.in/job-listing/*",
        "https://www.glassdoor.co.in/Job/*",
        "https://www.glassdoor.co.uk/job-listing/*",
        "https://www.glassdoor.co.uk/Job/*",
        "https://www.glassdoor.ca/job-listing/*",
        "https://www.glassdoor.ca/Job/*",
        "https://www.glassdoor.com.au/job-listing/*",
        "https://www.glassdoor.com.au/Job/*",
        "https://www.glassdoor.de/job-listing/*",
        "https://www.glassdoor.de/Job/*",
        "https://www.glassdoor.fr/job-listing/*",
        "https://www.glassdoor.fr/Job/*",
        "https://www.glassdoor.ie/job-listing/*",
        "https://www.glassdoor.ie/Job/*",
        "https://www.glassdoor.sg/job-listing/*",
        "https://www.glassdoor.sg/Job/*"
      ],
      "js": ["content-scripts/shared.js", "content-scripts/glassdoor.js"],
      "run_at": "document_idle"
    }
  ]
}